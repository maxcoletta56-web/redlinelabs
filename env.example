# Server-only. Required to create Stripe Checkout Sessions.
# Production (redlinelabs.shop) uses live keys only: sk_live_... not sk_test_...
# and not the key ID (mk_...).
STRIPE_SECRET_KEY=

# Required for Embedded Checkout (Stripe.js). Production must be pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Used if the request has no Origin/Host header.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional. Set to 1 to ignore test keys even outside Vercel production.
# STRIPE_REQUIRE_LIVE=1
