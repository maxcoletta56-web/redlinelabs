# Server-only. Payoneer Checkout merchant code (Basic auth username).
# Create a payment token in the Payoneer merchant portal. Production uses the
# live API (api.live.oscato.com). Set PAYONEER_ENV=sandbox only outside production.
PAYONEER_MERCHANT_CODE=
PAYONEER_PAYMENT_TOKEN=
# PAYONEER_ENV=live

# Optional. Used if the request has no Origin/Host header.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional. AssistLoop chat widget. Injected by the Vercel marketplace
# integration, or copy the Agent ID from AssistLoop → Settings → Integration.
NEXT_PUBLIC_ASSISTLOOP_AGENT_ID=

# Optional. Set to 1 to ignore test keys even outside Vercel production.
# STRIPE_REQUIRE_LIVE=1

# Neon Postgres, injected by the Vercel Neon integration. When either URL is
# set, `npm run build` applies db/comments.sql and db/orders.sql. Checkout
# orders are stored here so the Whop webhook can mark them paid.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Server-only. Whop card checkout. Create a sandbox API key at
# https://sandbox.whop.com/dashboard/developer and a webhook for
# payment.succeeded and payment.failed pointing at /api/webhooks/whop.
# Leave WHOP_ENV unset or set it to sandbox until you are ready for live charges.
# Sandbox test cards: 4242424242424242 succeeds, 4000000000000002 is declined,
# 5385308360135181 requires 3D Secure (password Checkout1!). Any future expiry and any CVC.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_COMPANY_ID=
# WHOP_ENV=sandbox
# Optional. Inline plans can omit this. Set it if Whop requires a product id.
# WHOP_PRODUCT_ID=

# Server-only. Confirmation email sent after payment.succeeded.
RESEND_API_KEY=
ORDER_FROM_EMAIL=

# Optional. Shown on the bank transfer instructions when all three are set.
# BANK_TRANSFER_ACCOUNT_NAME=
# BANK_TRANSFER_BSB=
# BANK_TRANSFER_ACCOUNT_NUMBER=
