# Server-only. Do not prefix these with NEXT_PUBLIC_.

# Whop company API key from the sandbox dashboard while testing.
WHOP_API_KEY=
# Webhook signing secret (ws_...). Used only by /api/webhooks/whop.
WHOP_WEBHOOK_SECRET=
# Company id, prefixed biz_.
WHOP_COMPANY_ID=
# sandbox (default when unset) or production.
WHOP_ENVIRONMENT=sandbox

# Confirmation email sent after payment.succeeded.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
