# Server-only. Required to create Stripe Checkout Sessions.
# Must be the secret itself (sk_test_... or sk_live_...), not the key ID (mk_...).
STRIPE_SECRET_KEY=

# Required for Embedded Checkout (Stripe.js).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Used if the request has no Origin/Host header.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
