# Server-only. Never expose these to the browser. Create them in the Whop
# sandbox dashboard (https://sandbox.whop.com/dashboard/developer) first.
# WHOP_COMPANY_ID is the account id, prefixed biz_.
# WHOP_ENV defaults to sandbox. Set WHOP_ENV=production for live charges.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_COMPANY_ID=
# WHOP_ENV=sandbox
# WHOP_PRODUCT_ID=

# Confirmation email after payment.succeeded. The webhook returns 500 so Whop
# retries when these are missing.
# RESEND_API_KEY=
# ORDER_FROM_EMAIL=

# Shown on the bank-transfer option. The order id is the payment reference.
# BANK_TRANSFER_ACCOUNT_NAME=
# BANK_TRANSFER_BSB=
# BANK_TRANSFER_ACCOUNT_NUMBER=

# Server-only. Payoneer Checkout merchant code (Basic auth username).
# Create a payment token in the Payoneer merchant portal. Production uses the
# live API (api.live.oscato.com). Set PAYONEER_ENV=sandbox only outside production.
PAYONEER_MERCHANT_CODE=
PAYONEER_PAYMENT_TOKEN=
# PAYONEER_ENV=live

# Optional. Used if the request has no Origin/Host header.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional. AssistLoop chat widget. Injected by the Vercel marketplace
# integration, or copy the Agent ID from AssistLoop → Settings → Integration.
NEXT_PUBLIC_ASSISTLOOP_AGENT_ID=

# Optional. Set to 1 to ignore test keys even outside Vercel production.
# STRIPE_REQUIRE_LIVE=1

# Neon Postgres, injected by the Vercel Neon integration. When either URL is
# set, `npm run build` applies db/comments.sql.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
