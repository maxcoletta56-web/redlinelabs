# Payment rail. `bank_transfer` (the default when unset) takes a manual
# Australian bank transfer or PayID and settles it out of band. `stripe`
# selects the hosted card rail, which is the Payoneer checkout below.
NEXT_PUBLIC_PAYMENTS_PROVIDER=bank_transfer

# Required when NEXT_PUBLIC_PAYMENTS_PROVIDER=bank_transfer. Shown to the
# customer on /order/[reference] as the transfer destination.
PAYID_ADDRESS=payments@example.com
PAYID_ACCOUNT_NAME=Example Pty Ltd

# Server-only. Bearer secret for POST /api/admin/orders/[reference]/paid and
# GET /api/admin/orders. Use a long random string; the admin endpoints stay
# closed while this is unset.
ADMIN_API_SECRET=replace-with-a-long-random-string

# Server-only. Payoneer Checkout merchant code (Basic auth username).
# Create a payment token in the Payoneer merchant portal. Production uses the
# live API (api.live.oscato.com). Set PAYONEER_ENV=sandbox only outside production.
# Only read when NEXT_PUBLIC_PAYMENTS_PROVIDER=stripe.
PAYONEER_MERCHANT_CODE=
PAYONEER_PAYMENT_TOKEN=
# PAYONEER_ENV=live

# Server-only. Whop company API key for embedded card checkout. Never prefix
# this with NEXT_PUBLIC_. Create a sandbox key at
# https://sandbox.whop.com/dashboard/developer. Unset WHOP_ENV (or set it to
# sandbox) calls https://sandbox-api.whop.com. Set WHOP_ENV=live only with a
# production key. Sandbox test cards: 4242 4242 4242 4242 succeeds,
# 4000 0000 0000 0002 is declined, and 5385 3083 6013 5181 requires 3D Secure
# (password Checkout1!). Any future expiry and any CVC work.
WHOP_API_KEY=
# Server-only. Signing secret for POST /api/webhooks/whop. Paste the ws_ value
# from the webhook endpoint in the same Whop environment as the API key. The
# HMAC key is that string. A whsec_ value is also accepted as Standard Webhooks
# base64.
WHOP_WEBHOOK_SECRET=
# WHOP_ENV=sandbox
# WHOP_ENVIRONMENT is read when WHOP_ENV is unset. sandbox is the default.
# Optional company id (biz_...) when the API key is not already scoped to one.
# WHOP_COMPANY_ID=
# Optional product id (prod_...) if inline plans must belong to a product.
# WHOP_PRODUCT_ID=

# Optional. Used if the request has no Origin/Host header.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional. AssistLoop chat widget. Injected by the Vercel marketplace
# integration, or copy the Agent ID from AssistLoop → Settings → Integration.
NEXT_PUBLIC_ASSISTLOOP_AGENT_ID=

# Optional. Set to 1 to ignore test keys even outside Vercel production.
# STRIPE_REQUIRE_LIVE=1

# Neon Postgres, injected by the Vercel Neon integration. When either URL is
# set, `npm run build` applies db/comments.sql and db/orders.sql. Required for
# bank transfer checkout, which stores every order in the `orders` table.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Transactional order email via Resend's HTTP API. Create a Resend account,
# verify the sending domain, then add RESEND_API_KEY in the Vercel project
# environment. Checkout still completes when the key is unset; the mailer logs
# once and sends nothing. ORDER_NOTIFY_EMAIL is the merchant copy and falls
# back to PAYID_ADDRESS when unset.
# RESEND_API_KEY=
# ORDER_EMAIL_FROM=Redline Labs <orders@redlinelabs.shop>
# ORDER_NOTIFY_EMAIL=
