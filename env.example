# Copy to .env.local and fill in. Never commit real keys.

# Server-only. Stripe Dashboard > Developers > API keys > Secret key > Reveal.
# sk_test_... for test mode, sk_live_... for live mode.
STRIPE_SECRET_KEY=

# Required for Embedded Checkout (Stripe.js runs in the browser).
# Must match the mode of the secret key above.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret for POST /api/webhooks/stripe.
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# Deployed: Dashboard > Developers > Webhooks > endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=

# Optional. Used if the request has no Origin/Host header.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
