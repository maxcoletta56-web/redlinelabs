# Payment rail. `bank_transfer` (the default when unset) takes a manual
# Australian bank transfer or PayID and settles it out of band. `paypal`
# selects PayPal card checkout below.
NEXT_PUBLIC_PAYMENTS_PROVIDER=bank_transfer

# Required when NEXT_PUBLIC_PAYMENTS_PROVIDER=bank_transfer. Shown to the
# customer on /order/[reference] as the transfer destination.
PAYID_ADDRESS=payments@example.com
PAYID_ACCOUNT_NAME=Example Pty Ltd

# Server-only. Bearer secret for POST /api/admin/orders/[reference]/paid and
# GET /api/admin/orders. Use a long random string; the admin endpoints stay
# closed while this is unset. Also signs distribution sessions when
# DISTRIBUTION_SESSION_SECRET is unset.
ADMIN_API_SECRET=replace-with-a-long-random-string

# Server-only. Signs the distribution login cookie. At least 16 random
# characters. When unset, distribution sign-in falls back to ADMIN_API_SECRET
# (also at least 16 characters). Rotating it signs every distributor out.
# DISTRIBUTION_SESSION_SECRET=replace-with-at-least-16-random-characters

# Optional, local development only. When DATABASE_URL is unset and this is 1,
# distribution applications and quotes stay in the dev server's memory.
# Ignored when NODE_ENV=production, including Vercel preview and production.
# DISTRIBUTION_DEV_STORE=1

# Server-only. Keys the HMAC that hashes Redline Club member codes. At least 32
# random characters. Without it joining and every credential check fail closed
# (HTTP 503) and the build-time club migration refuses to run if legacy
# plaintext codes still need hashing. Rotating it invalidates every issued code.
CLUB_CODE_SECRET=replace-with-at-least-32-random-characters

# Server-only. PayPal REST app credentials for card checkout.
# Create a REST app in the PayPal developer dashboard and copy the client id
# and secret. The card rail opens PayPal guest card checkout (Orders v2,
# landing_page GUEST_CHECKOUT) and captures the order when the buyer returns.
# Production uses the live API (api-m.paypal.com). Set PAYPAL_ENV=sandbox only
# outside production. Only read when NEXT_PUBLIC_PAYMENTS_PROVIDER=paypal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=live

# Optional. Used if the request has no Origin/Host header.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional. AssistLoop chat widget. Injected by the Vercel marketplace
# integration, or copy the Agent ID from AssistLoop → Settings → Integration.
NEXT_PUBLIC_ASSISTLOOP_AGENT_ID=

# Neon Postgres, injected by the Vercel Neon integration. When either URL is
# set, `npm run build` applies db/comments.sql, db/orders.sql, db/club.sql, and
# db/distribution.sql. Required for bank transfer checkout and distribution
# accounts. Orders are stored in the `orders` table.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Transactional order email via Resend's HTTP API. Create a Resend account,
# verify the sending domain, then add RESEND_API_KEY in the Vercel project
# environment. Checkout still completes when the key is unset; the mailer logs
# once and sends nothing. ORDER_NOTIFY_EMAIL is the merchant copy and falls
# back to PAYID_ADDRESS when unset.
# RESEND_API_KEY=
# ORDER_EMAIL_FROM=Redline Labs <orders@redlinelabs.shop>
# ORDER_NOTIFY_EMAIL=

# Server-only. Whop card checkout on /checkout. Sandbox until WHOP_SANDBOX=false.
# Create the key in the Whop dashboard (sandbox.whop.com while testing). The
# webhook signing secret is the ws_ value, pasted verbatim with no trailing
# newline. Point the webhook at POST /api/webhooks/whop for payment.succeeded
# and payment.failed. Test card while sandboxed: 4242 4242 4242 4242, any
# future expiry, any CVC. A 3D Secure challenge finishes in the embedded form
# or on /checkout/return. Never put WHOP_API_KEY in a NEXT_PUBLIC_ variable.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Optional account id, prefixed biz_. Sent as account_id when set.
# WHOP_COMPANY_ID=
# Set to false only when you are ready to charge live cards.
# WHOP_SANDBOX=false
