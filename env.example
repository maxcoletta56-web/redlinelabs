# Server-only. Required to create Stripe Checkout Sessions.
STRIPE_SECRET_KEY=

# Required for Embedded Checkout (Stripe.js).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Recommended. Used for Stripe return URLs and as a fallback when the request has no Origin/Host header.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
