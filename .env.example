# Payment rail kept for the legacy Payoneer path. Checkout always offers
# Australian bank transfer and Whop card together when each one is configured.
# `bank_transfer` is the default when unset. `stripe` selects Payoneer for
# POST /api/checkout calls that do not set paymentMethod to `card`.
NEXT_PUBLIC_PAYMENTS_PROVIDER=bank_transfer

# Server-only. Whop company API key. Never prefix this with NEXT_PUBLIC.
# Create it in the sandbox dashboard while testing, then replace it for live.
WHOP_API_KEY=

# Server-only. Webhook signing secret (`ws_...`) from the Whop webhook
# pointed at https://<your-domain>/api/webhooks/whop. Subscribe to
# payment.succeeded and payment.failed. Sandbox and live use different secrets.
WHOP_WEBHOOK_SECRET=

# Server-only. Whop account id, prefixed `biz_`.
WHOP_COMPANY_ID=

# `sandbox` (the default when unset) calls https://sandbox-api.whop.com and
# mounts the embedded checkout in sandbox mode. Set `live` only after test
# cards succeed. Sandbox cards: 4242 4242 4242 4242 succeeds, 4000 0000 0000
# 0002 declines, 5385 3083 6013 5181 requires 3D Secure (password Checkout1!).
WHOP_ENV=sandbox

# Server-only. Confirmation email sent when a Whop payment succeeds.
# https://resend.com — the From address must be on a verified domain.
RESEND_API_KEY=
ORDER_EMAIL_FROM=orders@example.com

# Required when NEXT_PUBLIC_PAYMENTS_PROVIDER=bank_transfer. Shown to the
# customer on /order/[reference] as the transfer destination.
PAYID_ADDRESS=payments@example.com
PAYID_ACCOUNT_NAME=Example Pty Ltd

# Server-only. Bearer secret for POST /api/admin/orders/[reference]/paid and
# GET /api/admin/orders. Use a long random string; the admin endpoints stay
# closed while this is unset.
ADMIN_API_SECRET=replace-with-a-long-random-string

# Server-only. Payoneer Checkout merchant code (Basic auth username).
# Create a payment token in the Payoneer merchant portal. Production uses the
# live API (api.live.oscato.com). Set PAYONEER_ENV=sandbox only outside production.
# Only read when NEXT_PUBLIC_PAYMENTS_PROVIDER=stripe.
PAYONEER_MERCHANT_CODE=
PAYONEER_PAYMENT_TOKEN=
# PAYONEER_ENV=live

# Optional. Used if the request has no Origin/Host header.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional. AssistLoop chat widget. Injected by the Vercel marketplace
# integration, or copy the Agent ID from AssistLoop → Settings → Integration.
NEXT_PUBLIC_ASSISTLOOP_AGENT_ID=

# Optional. Set to 1 to ignore test keys even outside Vercel production.
# STRIPE_REQUIRE_LIVE=1

# Neon Postgres, injected by the Vercel Neon integration. When either URL is
# set, `npm run build` applies db/comments.sql, db/orders.sql, and
# db/whop_payments.sql. Required for bank transfer and Whop card checkout,
# which store every order in the `orders` table.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
